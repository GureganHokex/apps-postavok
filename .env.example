# Django Settings
DJANGO_DEBUG=false
# Локально с SQLite: можно не задавать DJANGO_DEBUG — включится DEBUG. Или явно DJANGO_DEBUG=true.
# Сгенерируй свой секрет; не коммить реальные значения.
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret

# Domain Settings - для локальной разработки
FRONTEND_DOMAIN=localhost

# Django Allowed Hosts (через запятую)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CSRF Trusted Origins (через запятую, с протоколом)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# CORS Allowed Origins (через запятую, с протоколом)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# API URL для фронтенда (локально — CRA; на Vercel без FORCE запросы идут на тот же origin + /api → rewrite на Render)
REACT_APP_API_URL=http://localhost:8000/api

# Прямой backend в браузере (обход прокси Vercel→Render). Нужны CORS_ALLOWED_ORIGINS на Render и вход тоже на этот URL.
# REACT_APP_FORCE_API_URL=1

# Только multipart POST /upload/ на другой базе (редко: при сессии cookie с другого домена не отправятся — обычно используйте FORCE для всего API).
# REACT_APP_UPLOAD_API_URL=https://your-service.onrender.com/api

# Parser pipeline flags
# Локально для тестов: true / true / false (см. корневой .env после копирования)
# Включает V2: content-based маппинг колонок + native row extractor.
EXCEL_PARSER_PIPELINE_V2=false
# Принудительно оставляет legacy pipeline даже при включенном v2.
PARSER_LEGACY_FORCE=false
# Запускает второй pipeline в shadow и пишет сравнение в ParseRun.meta.shadow.
PARSER_SHADOW_MODE=false

# Database (SQLite by default; set DB_ENGINE=postgresql for PostgreSQL)
DB_ENGINE=sqlite3
DB_NAME=apps_postavok
DB_USER=apps_postavok
DB_PASSWORD=apps_postavok
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# Первый администратор приложения (команда create_admin_user и автозапуск в entrypoint при деплое)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=80
