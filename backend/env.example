DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://gureganhokex.github.io
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_LANGUAGE_CODE=ru-ru

# Database (SQLite by default; set DB_ENGINE=postgresql for PostgreSQL)
DB_ENGINE=sqlite3
DB_NAME=apps_postavok
DB_USER=apps_postavok
DB_PASSWORD=apps_postavok
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# Первый админ (create_admin_user; на Render задаётся в Dashboard, не в репозитории)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
